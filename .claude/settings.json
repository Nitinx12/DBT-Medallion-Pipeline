{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-env.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: use `uv run` for pytest/pre-commit/ruff. dbt commands need --project-dir walmart_dbt. main requires a PR (CodeQL-gated) — never push directly.'"
          }
        ]
      }
    ]
  }
}
