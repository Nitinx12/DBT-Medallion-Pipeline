# ==================================
# Postgres
# ==================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=walmart_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=changeme
# Managed providers like Neon require SSL ("require"); local Docker uses "prefer".
POSTGRES_SSLMODE=prefer
# Only needed when the provider mandates channel binding with sslmode=require.
POSTGRES_CHANNEL_BINDING=
POSTGRES_SCHEMA_BRONZE=bronze
POSTGRES_SCHEMA_SILVER=silver
POSTGRES_SCHEMA_GOLD=gold

# ==================================
# MONGODB
# ==================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB=walmart

# ===================================
# PYSPARK CONFIGURATION
# ===================================
# Windows: .venv\Scripts\python.exe  |  Linux/macOS: .venv/bin/python
PYSPARK_PYTHON=python
PYSPARK_DRIVER_PYTHON=python

# ============================
# Databricks Connection (optional — leave empty if not using Databricks)
# ============================
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=walmart
DATABRICKS_SCHEMA=public

# ============================
# Airflow (consumed via compose env_file; DAGs read the SMTP sender)
# ============================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:changeme@airflow-metadata:5432/airflow
AIRFLOW__CORE__FERNET_KEY=changeme
AIRFLOW__WEBSERVER__SECRET_KEY=changeme
AIRFLOW__SMTP__SMTP_HOST=smtp.example.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=you@example.com
AIRFLOW__SMTP__SMTP_PASSWORD=changeme
AIRFLOW__SMTP__SMTP_MAIL_FROM=you@example.com
AIRFLOW__SMTP__SMTP_SSL=false
AIRFLOW__SMTP__SMTP_STARTTLS=true
AIRFLOW_UID=50000
