# Streamlit secrets template for the Walmart dashboard.
# Copy to secrets.toml and fill real values, or paste the same keys into
# the Streamlit Community Cloud app Settings. Local runs use .env instead,
# so this file stays dummy values only and is safe to commit.
# Keep every key FLAT (no [sections]): dashboard/lib/db.py copies each
# top level key straight into os.environ, and a nested table would land
# in the environment as a dict string instead of a plain value.

# Cloud (Neon): use the POOLED host, the dashboard_ro user created by
# sql/security/dashboard_readonly_role.sql, and the Neon database name.
# Local (Docker Postgres): host localhost, your local user and password.
POSTGRES_HOST = "localhost"
POSTGRES_PORT = "5432"
POSTGRES_DATABASE = "walmart_db"
POSTGRES_USERNAME = "postgres"
POSTGRES_PASSWORD = "changeme"
POSTGRES_SCHEMA_BRONZE = "bronze"
POSTGRES_SCHEMA_SILVER = "silver"
POSTGRES_SCHEMA_GOLD = "gold"

# Managed providers like Neon require SSL. Set "require" on Cloud and
# leave "prefer" (or unset) for local Docker Postgres.
POSTGRES_SSLMODE = "prefer"
# Only needed when the provider mandates channel binding with
# sslmode=require. Leave empty otherwise.
POSTGRES_CHANNEL_BINDING = ""
